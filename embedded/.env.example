# NexusForge Embedded Environment Configuration

# WiFi Configuration (for ESP32 projects)
WIFI_SSID=your_wifi_ssid
WIFI_PASSWORD=your_wifi_password
WIFI_MAXIMUM_RETRY=5

# MQTT Configuration
MQTT_BROKER=mqtt.example.com
MQTT_PORT=1883
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password
MQTT_CLIENT_ID=nexusforge_device

# OTA Update Configuration
OTA_ENABLED=true
OTA_PASSWORD=secure_password
OTA_PORT=3232

# Device Configuration
DEVICE_NAME=nexusforge_device_01
DEVICE_ID=unique_device_id

# Serial Configuration
SERIAL_BAUDRATE=115200
SERIAL_DEBUG=true

# Build Configuration
BUILD_TYPE=release
ENABLE_LOGGING=true
LOG_LEVEL=info

# Flash Configuration
FLASH_SIZE=4MB
PARTITION_SCHEME=default

# Raspberry Pi Configuration
RPI_HOST=192.168.1.100
RPI_USER=pi
RPI_PASSWORD=raspberry

# Cross-compilation
CROSS_COMPILE_SYSROOT=/opt/rpi-tools/arm-bcm2708/arm-linux-gnueabihf/arm-linux-gnueabihf/sysroot
